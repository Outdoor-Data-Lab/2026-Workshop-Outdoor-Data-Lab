# Copy to .env and fill in: cp .env.sample .env
# .env is git-ignored; never commit real secrets.

# ---------- Docker Compose ----------
# Files chained by `docker compose` (base + environment override).
#   dev : docker-compose.yaml:docker-compose-dev.yaml
#   prod: docker-compose.yaml:docker-compose-prod.yaml
COMPOSE_FILE=docker-compose.yaml:docker-compose-dev.yaml

# ---------- PostgreSQL ----------
POSTGRES_DB=myapp
POSTGRES_USER=postgres
# Avoid URL-reserved characters (@ : / ? #): it is also put in TaxHub's DB URL.
POSTGRES_PASSWORD=change-me

# ---------- Django ----------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# ---------- Grids ----------
# ref_geo grid of the traffic counts and scores (default M0.5, 500 m; M1: 1 km),
# and the grids the counting objects are linked to (default M1,M0.5).
# After changing them, run manage.py sync_counting_object_areas, then refresh_cell_counts.
# DEFAULT_GRID_AREA_TYPE=M0.5
# AREA_TYPES=M1,M0.5

# ---------- Redis ----------
# Memory cap of Redis (Celery broker and cache); the cached area responses are evicted first.
# REDIS_MAXMEMORY=512mb

# ---------- TaxHub ----------
TAXHUB_SECRET_KEY=change-me
TAXHUB_IMAGE=lpoaura/taxhub:dev

# ---------- Production only ----------
# Public domain name; its DNS must point to the server (ports 80/443 open).
DOMAIN=example.org
# Contact email for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.org
# Gunicorn sizing. Total request concurrency is approximately workers x threads.
# WEB_CONCURRENCY=3
# Extra Gunicorn CLI options (values below are the production defaults).
# GUNICORN_CMD_ARGS=--threads 2 --graceful-timeout 30 --max-requests 1000 --max-requests-jitter 100
# Max duration of a request, in seconds (Gunicorn, and Traefik for uploads).
# Imports run in the Celery worker: only the upload of a big file needs time (default 600).
# GUNICORN_TIMEOUT=600
# Resources of the web container (defaults: 2g, 2 CPUs).
# WEB_MEMORY_LIMIT=2g
# WEB_CPUS_LIMIT=2
# Resources of the worker container, which runs the imports (defaults: 4g, 2 CPUs).
# WORKER_MEMORY_LIMIT=4g
# WORKER_CPUS_LIMIT=2
# TRAEFIK_LOG_LEVEL=INFO
